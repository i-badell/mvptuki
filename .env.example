# Supabase
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-key>
SUPABASE_SECRET_KEY=<your-service-role-key>

# MercadoPago
# Find in: MP Developer Dashboard → Your App → Credentials → Sandbox
# Use TEST-... tokens for local development
MP_ACCESS_TOKEN=TEST-<your-test-access-token>
MP_WEBHOOK_SECRET=<your-webhook-secret>

# App
# Used for MercadoPago back_urls (must be publicly accessible for webhooks)
NUXT_PUBLIC_APP_URL=http://localhost:3000
